# Postgres connection string for the backend.
# For local dev this is the default; the Docker setup overrides it via -e to
# point at host.docker.internal:5433.
DATABASE_URL=postgres://skill_radar:skill_radar@localhost:5432/skill_radar?sslmode=disable

# Directory where uploaded article attachments are stored (relative to the
# backend's working directory).
ATTACHMENT_DIR=attachments

# --- Spotlight AI assistant (POST /api/agent) ---
# The assistant talks to the SAP Hyperspace local proxy ("Hai" desktop app),
# which exposes the Anthropic Messages API at /anthropic/v1/messages and
# authenticates with Authorization: Bearer <key>.
#
# Both ANTHROPIC_API_KEY and BASE_URL must be set, or the endpoint returns 503
# and the UI falls back to local command parsing.

# Hyperspace proxy API key (a proxy token, NOT a direct Anthropic sk-ant- key).
ANTHROPIC_API_KEY=

# Base URL of the Hyperspace proxy.
#   - Running the backend directly on your host: http://localhost:6655
#   - Running the backend in Docker (basf-api):   http://host.docker.internal:6655
BASE_URL=http://localhost:6655

# Optional: Claude model id the proxy should use. Defaults to claude-sonnet-4-5.
# LLM_MODEL=claude-sonnet-4-5
